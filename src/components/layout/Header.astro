---
import Navigation from "../layout/Navigation.astro";
import axLogo from "../../assets/asset-analytix-logo.svg";
---
<div data-site-header-shell class="site-header-shell">
  <header data-site-header class="site-header relative bg-white transition-all duration-200 ease-out shadow-sm">
    <div class="mx-auto flex max-w-7xl justify-between items-center py-4 px-6 lg:px-8">
      <a href="/"><img src={axLogo.src} width="206" height="54" alt="AX Homepage" /></a>
      <Navigation />
    </div>
  </header>
</div>

<style>
  .site-header-shell {
    width: 100%;
  }

  .site-header {
    z-index: 120;
    width: 100%;
    will-change: opacity;
  }

  .site-header.is-stuck {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
  }

  .site-header.is-stuck.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  const initHeaderScroll = () => {
    const header = document.querySelector("[data-site-header]");
    const shell = document.querySelector("[data-site-header-shell]");
    if (
      !(header instanceof HTMLElement) ||
      !(shell instanceof HTMLElement) ||
      header.dataset.headerBound === "true"
    ) return;
    header.dataset.headerBound = "true";

    let ticking = false;
    let releasePending = false;
    let releaseToken = 0;
    const stickAt = 300;
    const transitionDuration = 200;

    const syncShellHeight = () => {
      shell.style.height = `${header.offsetHeight}px`;
    };

    const releaseHeader = () => {
      if (releasePending) return;
      releasePending = true;
      releaseToken += 1;
      const currentToken = releaseToken;

      window.setTimeout(() => {
        if (currentToken !== releaseToken) return;

        releasePending = false;

        if (window.scrollY < stickAt) {
          header.classList.remove("is-stuck");
        }
      }, transitionDuration);
    };

    const update = () => {
      const currentY = window.scrollY;
      syncShellHeight();

      if (currentY >= stickAt) {
        releasePending = false;
        header.classList.add("is-stuck");
        window.requestAnimationFrame(() => {
          header.classList.add("is-visible");
        });
      } else {
        header.classList.remove("is-visible");

        if (header.classList.contains("is-stuck")) {
          releaseHeader();
        }
      }

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update);
    syncShellHeight();
    update();
  };

  initHeaderScroll();
  document.addEventListener("DOMContentLoaded", initHeaderScroll);
  document.addEventListener("astro:page-load", initHeaderScroll);
</script>
