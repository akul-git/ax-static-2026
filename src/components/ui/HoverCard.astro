---
interface Props {
  image?: string;
  title?: string;
  description?: string;
}

const {
  image,
  title = "Hover Card",
  description = "Add content to customize this card.",
} = Astro.props;
---

<div class="group relative overflow-hidden rounded-2xl cursor-pointer">

  <!-- Image -->
  {image && (
    <img
      src={image}
      alt={title}
      class="h-30 w-full object-cover transition duration-700 group-hover:scale-100"
    />
  )}

  <!-- Dark Overlay -->
  <div
    class="absolute inset-0  opacity-0 transition duration-500 group-hover:opacity-100"
  ></div>

  <!-- Content -->
  <div
    class="absolute inset-x-0 bottom-0 translate-y-full transition-all duration-700 group-hover:translate-y-0"
  >

    <!-- Triangle -->
    <div
      class="h-20 bg-white"
      style="clip-path: polygon(0 100%, 100% 0%, 100% 100%);"
    ></div>

    <!-- Card -->
    <div class="bg-white  py-1 px-10   h-40 ">

      <h3 class="text-2xl font-bold mb-4">
        {title}
      </h3>

      <p class="text-gray-600 mb-4">
        {description}
      </p>

      <!-- <button
        class="rounded-full bg-black px-5 py-2 text-white hover:bg-blue-600 transition"
      >
        Read More
      </button> -->

    </div>

  </div>

</div>