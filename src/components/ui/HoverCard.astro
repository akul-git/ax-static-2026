---
interface Props {
  image?: string;
  title?: string;
  description?: string;
}

const {
  image,
  title = "Hover Card",
  description = "Add content to customize this card.",
} = Astro.props;
---

<div class="group relative rounded-2xl cursor-pointer isolate">
  <!-- Image -->
  <div class="rounded-2xl overflow-hidden">
    {
      image && (
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
      )
    }
  </div>

  <!-- Dark Overlay -->
  <div
    class="absolute inset-0 rounded-2xl opacity-0 transition duration-500 group-hover:opacity-100"
  >
  </div>

  <!-- Content -->
  <div
    class="absolute inset-0 flex items-end rounded-2xl overflow-hidden pointer-events-none"
  >
    <!-- Triangle
    <div
      class="h-20 bg-white/20 backdrop-blur-lg"
      style="clip-path: polygon(0 100%, 100% 0%, 100% 100%);"
    ></div> -->

    <!-- Card -->
    <div
      class="w-full translate-y-full transition-all duration-700 group-hover:translate-y-0 pointer-events-auto rounded-b-2xl h-2/3 overflow-hidden bg-white/50 backdrop-blur-lg py-1 px-10"
    >
      <h3 class="text-xl font-bold mt-3 mb-1">
        {title}
      </h3>

      <p>
        {description}
      </p>

      <!-- <button
        class="rounded-full bg-black px-5 py-2 text-white hover:bg-blue-600 transition"
      >
        Read More
      </button> -->
    </div>
  </div>
</div>
