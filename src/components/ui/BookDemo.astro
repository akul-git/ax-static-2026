---
import Button from "./Button.astro";

const calendlyHref = "https://calendly.com/edward-stanek/asset-analytix-introduction";

const {
  class: className = "",
  backgroundImage = "",
  backgroundAlt = "Book a demo background",
  href = calendlyHref,
  target,
  rel,
  buttonLabel = "BOOK A DEMO",
  demoHeading = "",
  overlay = "rgb(0 0 0 / 10%)",
  minHeight = "18rem",
} = Astro.props;

const normalizedHref = String(href || "").trim();
const resolvedHref = normalizedHref === "/book-demo" ? calendlyHref : normalizedHref;
const isExternalHref = /^https?:\/\//i.test(resolvedHref);
const resolvedTarget = target ?? (isExternalHref ? "_blank" : undefined);
const resolvedRel = rel ?? (resolvedTarget === "_blank" ? "noopener noreferrer" : undefined);
---

<section
  class={`group relative overflow-hidden rounded-sm ${className}`.trim()}
  style={`min-height:${minHeight};`}
  aria-label="Book a demo"
>
  {backgroundImage ? (
    <img
      src={backgroundImage}
      alt={backgroundAlt}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      loading="lazy"
    />
  ) : null}

  <div class="absolute inset-0" style={`background:${overlay};`}></div>

  <div class="relative z-10 flex min-h-[inherit] flex-col items-center justify-center gap-4 px-6 py-8">
    {demoHeading ? (
      <span class="text-center text-xl font-bold text-white">
        {demoHeading}
      </span>
    ) : null}
    <Button
      href={resolvedHref}
      target={resolvedTarget}
      rel={resolvedRel}
      class="rounded-lg bg-accent px-12 py-4 text-4xl font-bold  text-white shadow-lg hover:bg-sky-700"
    >
      {buttonLabel}
    </Button>
  </div>
</section>
