---
import LayoutSection from "./LayoutSection.astro";

const {
  class: className = "",

  variant = "default",

  shape = "none",

  bgImage = "",

  padding = "py-8",

  containerClass = "",

  contentClass = "",
} = Astro.props;
---

<LayoutSection
  variant={variant}
  shape={shape}
  bgImage={bgImage}
  padding={padding}
  class={className}
  containerClass={containerClass}
  contentClass={contentClass}
>
  <slot />
</LayoutSection>