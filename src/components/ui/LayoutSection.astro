---
export interface Props {
  variant?: "default" | "surface" | "image" | "dark";

  shape?:
    | "none"
    | "clip-top"
    | "clip-bottom"
    | "diagonal"
    | "diagonal-reverse"
    | "right-top-bottom-clipped"
    | "left-top-bottom-clipped";

  bgImage?: string;

  /** Vertical spacing */
  padding?: string;

  /** Additional classes on the <section> */
  class?: string;

  /** Legacy name (keep for compatibility) */
  contentClass?: string;

  /** Preferred name */
  containerClass?: string;

  /** Inline styles for the section */
  style?: string;

  /** Optional HTML id */
  id?: string;
}

const {
  variant = "default",
  shape = "none",

  bgImage = "",

  padding = "py-8",

  class: sectionClass = "",

  contentClass = "",

  containerClass = "",

  style: customStyle = "",

  id = "",
} = Astro.props;

const variantClasses = {
  default: "bg-white",

  surface: "bg-slate-100",

  image: "bg-cover bg-center bg-no-repeat",

  dark: "bg-slate-900 text-white",
};

const shapeClass = {
  none: "",

  "clip-top": "layout-section--clip-top",

  "clip-bottom": "layout-section--clip-bottom",

  diagonal: "layout-section--diagonal",

  "diagonal-reverse": "layout-section--diagonal-reverse",

  "right-top-bottom-clipped": "layout-section--right-top-bottom-clipped",

  "left-top-bottom-clipped": "layout-section--left-top-bottom-clipped",
};

const style = [
  variant === "image" && bgImage
    ? `background-image:url('${bgImage}')`
    : "",
  customStyle,
]
  .filter(Boolean)
  .join(";");
---

<section
  id={id}
  class:list={[
    variantClasses[variant],
    shapeClass[shape],
    padding,
    sectionClass,
  ]}
  style={style}
>
<article
  class:list={[
    "mx-auto",
    "max-w-9xl",
    "px-6",
    "lg:px-8",

    contentClass,

    containerClass,
  ]}
>
    <slot />
  </article>
</section>

<style>
.layout-section--clip-top {
  clip-path: polygon(0 15%, 100% 0, 100% 100%, 0 100%);
}

.layout-section--clip-bottom {
  clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
}

.layout-section--diagonal {
  clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 88%);
}

.layout-section--diagonal-reverse {
  clip-path: polygon(0 0, 100% 12%, 100% 88%, 0 100%);
}

.layout-section--right-top-bottom-clipped {
  clip-path: polygon(0 0, 100% 12%, 100% 88%, 0 100%);
}

.layout-section--left-top-bottom-clipped {
  clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 88%);
}
</style>