---
export interface Props {
  variant?: "default" | "surface" | "image" | "dark";

 shape?:
  | "none"

  | "clip-top-left"
  | "clip-top-right"

  | "clip-bottom-left"
  | "clip-bottom-right"

  | "diagonal"
  | "diagonal-reverse"

  | "right-top-bottom-clipped"
  | "left-top-bottom-clipped";

  bgImage?: string;

  /** Vertical spacing */
  padding?: string;

  /** Extra classes on the section */
  class?: string;

  /** Container width preset */
  containerSize?: "7xl" | "8xl" | "9xl" | "full";

  /** Extra classes on the inner container */
  containerClass?: string;

  /** Remove container wrapper */
  fullWidth?: boolean;

  /** Inline styles */
  style?: string;

  /** Optional section id */
  id?: string;
}

const {
  variant = "default",
  shape = "none",

  bgImage = "",

  padding = "py-8",

  class: sectionClass = "",

  containerSize = "9xl",

  containerClass = "",

  fullWidth = false,

  style: customStyle = "",

  id = "",

  ...rest
} = Astro.props;

const variantClasses = {
  default: "bg-transparent",

  surface: "bg-neutral-100",

  image: "bg-contain bg-center bg-no-repeat",

  dark: "bg-slate-900 text-white",
};

const shapeClass = {
  none: "",

  "clip-top-left": "layout-section--clip-top-left",

  "clip-top-right": "layout-section--clip-top-right",

  "clip-bottom-left": "layout-section--clip-bottom-left",

  "clip-bottom-right": "layout-section--clip-bottom-right",

  diagonal: "layout-section--diagonal",

  "diagonal-reverse": "layout-section--diagonal-reverse",

  "right-top-bottom-clipped":
    "layout-section--right-top-bottom-clipped",

  "left-top-bottom-clipped":
    "layout-section--left-top-bottom-clipped",
};

const containerSizes = {
  "7xl": "max-w-7xl",

  "8xl": "max-w-8xl",

  "9xl": "max-w-9xl",

  full: "max-w-full",
};

const computedStyle = [
  variant === "image" && bgImage
    ? `background-image:url('${bgImage}')`
    : "",
  customStyle,
]
  .filter(Boolean)
  .join(";");
---

<section
  id={id}
  class:list={[
    variantClasses[variant],
    shapeClass[shape],
    padding,
    sectionClass,
  ]}
  style={computedStyle}
  {...rest}
>
  {
    fullWidth ? (
      <slot />
    ) : (
      <div
        class:list={[
          "mx-auto",
          containerSizes[containerSize],
          "px-4 lg:px-8",
          containerClass,
        ]}
      >
        <slot />
      </div>
    )
  }
</section>

<style>
/* Top-left corner clipped */

.layout-section--clip-top-left {
  clip-path: polygon(
    0 18%,
    100% 0,
    100% 100%,
    0 100%
  );
}

/* Top-right corner clipped */

.layout-section--clip-top-right {
  clip-path: polygon(
    0 0,
    100% 18%,
    100% 100%,
    0 100%
  );
}

/* Bottom-left corner clipped */

.layout-section--clip-bottom-left {
  clip-path: polygon(
    0 0,
    100% 0,
    100% 100%,
    0 85%
  );
}

/* Bottom-right corner clipped */

.layout-section--clip-bottom-right {
  clip-path: polygon(
    0 0,
    100% 0,
    100% 85%,
    0 100%
  );
}

  .layout-section--diagonal {
    clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 88%);
  }

  .layout-section--diagonal-reverse {
    clip-path: polygon(0 0, 100% 12%, 100% 88%, 0 100%);
  }

  .layout-section--right-top-bottom-clipped {
    clip-path: polygon(0 0, 100% 12%, 100% 88%, 0 100%);
    box-shadow: inset -1rem -1px 20rem hsl(220deg 12% 90.2%);
  }

  .layout-section--left-top-bottom-clipped {
    clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 88%);
  }
</style>