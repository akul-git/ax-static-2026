---
type Props = {
    portalId: string;
    formId: string;
    region?: string;
    uniqueKey?: string;
    pageName?: string;
};

const {
    portalId,
    formId,
    region = "eu1",
    uniqueKey = formId,
    pageName,
} = Astro.props;
---

<div id={`hubspot-form-${uniqueKey}`}></div>

<script define:vars={{ portalId, formId, region, uniqueKey, pageName }}>
    const target = `#hubspot-form-${uniqueKey}`;

    function createForm() {
        if (!window.hbspt) return;

        window.hbspt.forms.create({
            portalId,
            formId,
            region,
            target,
            ...(pageName ? { pageName } : {}),
        });
    }

    if (!window.hbspt) {
        const script = document.createElement("script");
        script.src = `https://js-${region}.hsforms.net/forms/embed/v2.js`;
        script.onload = createForm;
        document.body.appendChild(script);
    } else {
        createForm();
    }
</script>
