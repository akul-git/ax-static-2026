---
import Layout from "../../layouts/BaseLayout.astro";
import LayoutSection from "../../components/ui/LayoutSection.astro";
import HeroBanner from "../../components/ui/HeroBanner.astro";
import WebinarForm from "../../components/ui/WebinarForm.astro";

import "../../styles/global.css";

const webinarVideos = [
  {
    slug: "Beyond-Metrics-Continuous-Improvement",
    title: "Beyond Metrics: Continuous Improvement and Performance",
    description:
      "Visualizing sustainable organizational growth through an integrated performance model.",
    thumbnail: "/assets/images/thumbnail_Beyond-Metrics.jpg",
    duration: "59 min",
    portalId: "25291755",
    formId: "88983a4a-2ebf-4e4c-8088-c344bddb2cae",
    videoUrl:"/media/Beyond-Metrics Continuous-Improvement-And-Performance.mp4",

  },
  {
    slug: "Webinar-Asset-Onboarding",
    title: "Webinar-Asset-Onboarding",
    description:
      "Bridge Project and Reliability teams to reduce labor 20–40%, avoid delays, and achieve operational excellence from day one.",
    thumbnail: "/assets/images/thumbnail_asset-onboarding.jpg",
    duration: "57 min",
    portalId: "25291755",
    formId: "88983a4a-2ebf-4e4c-8088-c344bddb2cae",
    videoUrl:"/media/Webinar-Asset-Onboarding.mp4",

  },
  {
    slug: "The-Hidden-Cost-of-Bad-EAMCMMS-Data",
    title: "The Hidden Cost of Bad EAMCMMS Data",
    description:
      "Focus your limited resources on the most impactful actions immediately.",
    thumbnail: "/assets/images/impact-of-bad-thumbnail_cmms-data.jpg",
    duration: "01:58 min",
    portalId: "25291755",
    formId: "88983a4a-2ebf-4e4c-8088-c344bddb2cae",
    videoUrl:"/media/Webinar-The Hidden Cost Of Bad Eamcmms Data — And How To Make Yours Analytics-Ready.mp4",

  },

];
---

<Layout>
  <LayoutSection containerSize="full" padding="p-0">
    <div class="text-center text-shadow-md text-shadow-neutral-950">
      <HeroBanner
        height="sm"
        image="../../assets/images/banner_webinar-recording.jpg"
      >
        <h1
          class="text-3xl sm:text-5xl lg:text-6xl font-medium leading-tight text-white"
        >
          Webinar Library
        </h1>
        <p
          class="mt-4 max-w-3xl mx-auto text-base sm:text-2xl lg:text-3xl leading-snug sm:leading-relaxed text-white"
        >
         Browse our on-demand webinar collection
        </p>
      </HeroBanner>
    </div>
  </LayoutSection>

  <LayoutSection padding="py-16">
    <div class="max-w-6xl mx-auto">
      <!-- <div class="text-center mb-12">
        <p class="text-sm uppercase tracking-[0.3em] text-slate-500">
          Webinar library
        </p>
        <h2 class="mt-4 text-4xl font-semibold">Recent webinar videos</h2>
      </div> -->

      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {
          webinarVideos.map((video) => (
            <article
              class="webinar-card group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-md"
              data-slug={video.slug}
              data-video-url={video.videoUrl}
            >
              <div class="relative overflow-hidden cursor-pointer">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  class="h-56 w-full object-cover transition duration-300 group-hover:scale-105"
                />

                <div class="locked-overlay absolute inset-0 flex flex-col items-center justify-center gap-3 bg-slate-950/55">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/15 text-2xl text-white backdrop-blur-sm">
                    <i class="fa-solid fa-lock-keyhole"></i>
                  </span>
                  <button
                    type="button"
                    class="unlock-btn rounded-full bg-white px-5 py-2 text-sm font-semibold text-slate-900 shadow-sm transition hover:bg-slate-100"
                    data-open-dialog={`dialog-${video.slug}`}
                  >
                    Watch Webinar
                  </button>
                </div>

                <div class="unlocked-overlay absolute inset-0 hidden items-center justify-center bg-slate-950/20 opacity-0 transition group-hover:opacity-100">
                  <span class="play-btn inline-flex h-14 w-14 items-center justify-center rounded-full bg-white/90 text-xl font-semibold text-slate-900">
                    ▶
                  </span>
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center justify-between">
                  <span class="text-xs uppercase tracking-[0.3em] text-slate-500">
                    {video.duration}
                  </span>
                  <span class="status-badge text-xs font-medium text-slate-400">
                    <i class="fa-solid fa-lock-keyhole"></i> Locked
                  </span>
                </div>
                <h3 class="mt-3 text-xl font-semibold">{video.title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">
                  {video.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    {
      webinarVideos.map((video) => (
        <dialog
          id={`dialog-${video.slug}`}
          class="webinar-form-dialog w-full max-w-2xl rounded-2xl p-0 backdrop:bg-slate-950/60"
          data-slug={video.slug}
        >
          <div class="relative p-6">
            <button
              type="button"
              data-close-dialog
              aria-label="Close"
              class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100"
            >
              ✕
            </button>
            <h3 class="text-xl font-semibold pr-8">{video.title}</h3>
            <p class="mt-1 text-sm text-slate-500">
              Fill out the form to watch this webinar.
            </p>
            <div class="mt-6">
              <WebinarForm
                portalId={video.portalId}
                formId={video.formId}
                uniqueKey={video.slug}
                pageName={`Resources | Asset Analytix — ${video.title}`}
              />
            </div>
          </div>
        </dialog>
      ))
    }

    {/* single shared video dialog for playback */}
    <dialog
      id="webinar-video-dialog"
      class="w-full max-w-4xl rounded-2xl p-0 backdrop:bg-slate-950/60"
    >
      <div class="relative p-4">
        <button
          type="button"
          data-close-dialog
          aria-label="Close"
          class="absolute right-6 top-6 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-slate-500 hover:bg-slate-100"
        >
          ✕
        </button>
        <div class="aspect-video w-full overflow-hidden rounded-xl bg-black">
          <iframe
            id="video-dialog-iframe"
            class="h-full w-full"
            src=""
            title="Webinar video"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen></iframe>
        </div>
      </div>
    </dialog>
  </LayoutSection>
</Layout>

<style>
  dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    max-height: 90vh;
    overflow-y: auto;
    z-index: 50;
  }

  dialog[open] {
    animation: dialog-in 0.18s ease-out;
  }

  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  /* manual backdrop, replaces ::backdrop since we no longer use showModal() */
  #modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(2, 6, 23, 0.6);
    z-index: 40;
    display: none;
  }

  #modal-backdrop.is-visible {
    display: block;
  }

  /* unlocked card state */
  .webinar-card.is-unlocked .locked-overlay {
    display: none;
  }
  .webinar-card.is-unlocked .unlocked-overlay {
    display: flex;
  }
  .webinar-card.is-unlocked .status-badge {
    display: none;
  }
</style>

<div id="modal-backdrop"></div>

<script>
  const STORAGE_PREFIX = "webinar-unlocked-";

  const backdrop = document.getElementById("modal-backdrop");

  const videoDialog = document.getElementById(
    "webinar-video-dialog",
  ) as HTMLDialogElement | null;
  const videoIframe = document.getElementById(
    "video-dialog-iframe",
  ) as HTMLIFrameElement | null;

  const cards = document.querySelectorAll<HTMLElement>(".webinar-card");

  function isUnlocked(slug: string) {
    return localStorage.getItem(STORAGE_PREFIX + slug) === "true";
  }

  function unlock(slug: string) {
    localStorage.setItem(STORAGE_PREFIX + slug, "true");
  }

  function applyLockState(card: HTMLElement) {
    const slug = card.dataset.slug;
    card.classList.toggle("is-unlocked", !!slug && isUnlocked(slug));
  }

  function openDialogEl(dialog: HTMLDialogElement | null) {
    if (!dialog) return;
    dialog.show(); // non-modal: keeps normal stacking context, so reCAPTCHA renders above it
    backdrop?.classList.add("is-visible");
  }

  function closeDialogEl(dialog: HTMLDialogElement | null) {
    if (!dialog) return;
    dialog.close();
    backdrop?.classList.remove("is-visible");
  }

  function openVideo(card: HTMLElement) {
    if (videoIframe) videoIframe.src = card.dataset.videoUrl ?? "";
    openDialogEl(videoDialog);
  }

  // initial state on load
  cards.forEach(applyLockState);

  cards.forEach((card) => {
    const unlockBtn = card.querySelector<HTMLElement>(".unlock-btn");
    const playBtn = card.querySelector<HTMLElement>(".play-btn");

    unlockBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const dialogId = unlockBtn.getAttribute("data-open-dialog");
      const dialog = dialogId
        ? (document.getElementById(dialogId) as HTMLDialogElement | null)
        : null;
      openDialogEl(dialog);
    });

    playBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      openVideo(card);
    });
  });

  document.querySelectorAll("[data-close-dialog]").forEach((btn) => {
    btn.addEventListener("click", () => {
      closeDialogEl(btn.closest("dialog") as HTMLDialogElement | null);
    });
  });

  // clicking the backdrop closes whichever dialog is open
  backdrop?.addEventListener("click", () => {
    const openDialog =
      document.querySelector<HTMLDialogElement>("dialog[open]");
    closeDialogEl(openDialog);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const openDialog =
        document.querySelector<HTMLDialogElement>("dialog[open]");
      closeDialogEl(openDialog);
    }
  });

  videoDialog?.addEventListener("close", () => {
    if (videoIframe) videoIframe.src = "";
  });

  window.addEventListener("message", (event) => {
    if (
      event.data?.type === "hsFormCallback" &&
      event.data?.eventName === "onFormSubmitted"
    ) {
      const openDialog = document.querySelector<HTMLDialogElement>(
        "dialog.webinar-form-dialog[open]",
      );
      const slug = openDialog?.dataset.slug;
      if (!slug) return;

      unlock(slug);

      const card = document.querySelector<HTMLElement>(
        `.webinar-card[data-slug="${slug}"]`,
      );
      if (card) applyLockState(card);

      setTimeout(() => {
        closeDialogEl(openDialog);
        if (card) openVideo(card);
      }, 1200);
    }
  });
</script>
