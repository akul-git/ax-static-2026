---
import Layout from "../../layouts/BaseLayout.astro";
import Section from "../../components/ui/Section.astro";
import HeroBanner from "../../components/ui/HeroBanner.astro";
import Blockquote from "../../components/ui/Blockquote.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import "../../styles/global.css";
import Heading from "../../components/ui/Heading.astro";
import ContactForm from "../../components/ui/ContactForm.astro";
import HubSpotForm from "../../components/ui/HubSpotForm.astro";
import LayoutSection from "../../components/ui/LayoutSection.astro";

const status = Astro.url.searchParams.get("status") || "";

const isSuccess = status === "submitted";

const errorMessages = {
  invalid: "Please complete all required fields with valid information.",
  captcha_error: "CAPTCHA verification failed. Please try again.",
  rate_limited: "Too many attempts. Please wait a few minutes and retry.",
  origin_error: "Request origin could not be verified.",
  payload_too_large: "Submission payload is too large.",
  delivery_not_configured:
    "Form delivery is not configured yet. Set SMTP and recipient environment variables.",
  server_error: "Something went wrong on our side. Please try again shortly.",
};
const errorMessage = errorMessages[status as keyof typeof errorMessages] || "";
---


<Layout>
  <!--Hello changes -->
  <!-- Hero -->
      <LayoutSection containerSize="full" padding="p-0">
    <div class="text-center text-shadow-md text-shadow-neutral-950">
      <HeroBanner height="sm" image="../../assets/images/asset-criticality-banner-01.jpg">
       <h1 class="text-3xl sm:text-5xl  lg:text-6xl font-medium leading-tight text-white">
           About Asset Analytix
        </h1>
       
      </HeroBanner>
    </div>
  </LayoutSection>
  <!-- Content -->

  <LayoutSection containerSize="7xl" padding="py-8">
      <div>
        <p class=" leading-relaxed">
          Since 1995,
          <strong>Asset Analytix</strong>
          has focused on one primary objective: Help our clients at all levels of
          their organization get control of managing the entire life cycle of their
          assets. Our
          <strong>team of experts</strong>
          are not just trainers, coaches and guides; we are former practitioners with
          the experience to help you quickly identify, manage and close performance-limiting
          gaps in your
          <strong>Reliability &amp; Asset Management</strong>
          programs.
        </p>
      </div>

      <!-- Mission -->
      <div>
        <Heading level={5} class="mt-4 mb-0!">
            <span class="block text-accent">Mission</span>
          </Heading>
       
        <p class=" leading-relaxed">
          To be the catalyst that empowers organizations worldwide with
          intelligent, data-driven asset management solutions—maximizing
          performance, elevating reliability program maturity, and delivering
          sustainable value across the asset lifecycle.
        </p>
      </div>

      <!-- Vision -->
      <div>
        <Heading level={5} class="mt-4 mb-0!">
            <span class="block text-accent">Vision</span>
          </Heading>


        <p class=" leading-relaxed">
          To redefine the future of asset management by enabling organizations
          to harness the power of data, optimize reliability strategies, and
          build resilient, future-ready operations that deliver measurable,
          sustainable value.
        </p>
      </div>
  </LayoutSection>
<LayoutSection containerSize="7xl" padding="py-8">
 <div class="mx-auto flex flex-col gap-7">
      <!-- Intro -->
    

      <!-- Quote -->
      <Blockquote
        variant="quote"
        textColor="text-[#1e73be]"
        class="border-none shadow-none"
        quote="Our core philosophy: Design solutions that simplify the process of improving."
      />

      <!-- Image -->
      <div class="grid grid-cols-7 ml-8 gap-8 items-start">
        <!-- Left Image -->
        <div class="col-span-3">
          <img
            src="../../assets/images/About-us-triangle.png"
            alt="Asset Analytix Office Locations"
            class="w-full max-w-sm"
          />
        </div>

        <!-- Right Content -->
        <div class="col-span-4">

          <Heading level={5} class="mb-4 ">
            <span class="block text-accent"> We are proud and excited to...</span>
          </Heading>
     

          <p class="mb-6 ">
            ...provide a total end-to-end solution; The perfect combination of
            expertise, processes and tools to accomplish your asset management
            objectives including:
          </p>
          <div class="mb-4">
            <ul class="list-disc space-y-1.5 pl-6 mt-4 marker:text-accent">
              <li>
                Subject matter expertise to accelerate your journey in training,
                coaching or delivery
              </li>
              <li>Standardized processes for consistency and scale</li>
              <li>
                Information / Performance analytics to activate insight in the
                clutter of data
              </li>
              <li>The ECR score is used to just prioritize work</li>
              <li>
                Software solutions for implementing change to simplify and
                automate change
              </li>
            </ul>
          </div>

          <p class=" leading-relaxed mb-8">
            <strong
              >Asset Analytix focuses our solutions at all levels of an
              organization;</strong
            >
            from Corporate CoE program design and management to local site deployment.
            This top-down / bottom-up approach has proven to be the perfect balance
            of standardization, leverage and scale as well as solving localized problems
            for true cultural transformation.
          </p>

          <!-- Services -->
          <div class="grid grid-cols-3 gap-x-5 gap-y-5 mt-2">
            <div class="flex gap-4">
              <span class="icon-ax-08 text-sky-700 text-5xl"></span>
              <div class="font-bold text-brand">Maintenance & Engineering</div>
            </div>
            <div class="flex gap-4">
              <span class="icon-ax-04 text-sky-700 text-5xl"></span>
              <div class="font-bold text-brand">Reliability Engineering</div>
            </div>
            <div class="flex gap-4">
              <span class="icon-ax-05 text-sky-700 text-5xl"></span>
              <div class="font-bold text-brand">IT, Systems and Data</div>
            </div>
            <div class="flex gap-4">
              <span class="icon-ax-07 text-sky-700 text-5xl"></span>
              <div class="font-bold text-brand">Storeroom</div>
            </div>
            <div class="flex gap-4">
              <span class="icon-ax-06 text-sky-700 text-5xl"></span>
              <div class="font-bold text-brand">Operational Excellence</div>
            </div>
            <div class="flex gap-4">
              <span class="icon-ax-10 text-sky-700 text-5xl"></span>
              <div class="font-bold text-brand">Facilities & Utilities</div>
            </div>
          </div>
        </div>
      </div>

 
    </div>
</LayoutSection>

<LayoutSection containerSize="7xl" padding="py-8" variant="surface" shape="diagonal" padding="py-30">
      <div>
        <div class="flex flex-col">
          <Eyebrow class="text-black"> BOTTOM LINE RESULTS </Eyebrow>

          <Heading level={5} class="mb-4 ">
            <span class="block text-brand">Quantifiable Improvements in the Shortest Time</span>
          </Heading>

          <p class=" mt-2">
            Our solutions open capacity, improve system performance, reduce cost
            and elevate reliability by addressing key aspects of your
            Reliability & asset management program including: asset
            commissioning / onboarding, asset strategies (PMOptimization), TPM
            Operator Driven Reliability, Failure management, Work execution
            management, planning & scheduling, MRO storeroom optimization, CMMS
            optimization, Measures/Reporting and Analytics, and program
            performance management; all wrapped with analytics.
          </p>

          <Heading level={5}>
            <span class="block text-neutral-500 text-center italic my-6">We truly are the shortest distance from Data to Action.</span>
          </Heading>
          <div class="text-black font-semibold text-center">
            <div class="w-32 border-t-2 border-gray-400 mx-auto"></div>
            <p class="py-4">
              We look forward to sharing with you our unique approach and toolkit
              to take your Reliability & Asset Management program to a whole new
              level.
            </p>
            <div class="w-32 border-t-2 border-gray-400 mx-auto"></div>
          </div>
        </div>
      </div> 
</LayoutSection>

  <LayoutSection containerSize="7xl" padding="py-8">
  <div class="grid gap-10 xl:grid-cols-2">
